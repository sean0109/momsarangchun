# DirectoryIndex: 디렉토리 접근 시 우선 탐색할 파일 목록
# - 각 서브페이지를 디렉토리명.html 로 두기 위해 후보 파일명들을 명시
# - 예) /about/ 진입 시 about.html, /guide/ 진입 시 guide.html
DirectoryIndex index.html about.html contact.html guide.html longterm-care.html services.html support.html

# Enable URL rewriting
RewriteEngine On

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve .html files for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Custom error pages (optional)
ErrorDocument 404 /404.html